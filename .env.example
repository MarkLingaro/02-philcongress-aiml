# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=philcongressai
POSTGRES_USER=philcongress
POSTGRES_PASSWORD=changeme
DATABASE_URL_SYNC=postgresql://philcongress:changeme@localhost:5432/philcongressai

# ── Neo4j ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── BetterGov API ─────────────────────────────────────────────────
BETTERGOV_BASE_URL=https://open-congress-api.bettergov.ph

# ── Bill PDF Downloader ───────────────────────────────────────────
BILL_PDF_DIR=data/raw/bills
BILL_DOWNLOAD_CONCURRENCY=5
BILL_DOWNLOAD_DELAY=0.5

# ── FastAPI ───────────────────────────────────────────────────────
API_PORT=8000

# ── Streamlit ─────────────────────────────────────────────────────
STREAMLIT_PORT=8501
